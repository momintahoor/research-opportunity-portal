        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"SDN Traffic Optimization\",\n  \"description\": \"Design and evaluate software-defined networking controllers for campus network traffic optimization.\",\n  \"researchArea\": \"Computer Networks\",\n  \"facultyName\": \"Dr. Bilal Ahmed\",\n  \"department\": \"Computer Science\",\n  \"requiredSkills\": \"Python, Networking, Mininet\",\n  \"availablePositions\": 3,\n  \"applicationDeadline\": \"2026-11-30\",\n  \"status\": \"Open\"\n}"
