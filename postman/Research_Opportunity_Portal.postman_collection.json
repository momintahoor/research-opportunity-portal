{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Research Opportunity Portal",
    "description": "API tests for the University Research Opportunity Portal.\n\nHow to use:\n1. Start the backend (npm start in backend/).\n2. Import this collection into Postman.\n3. Confirm collection variables: baseUrl=http://localhost:3000 and opportunityId.\n4. Run requests 1–10 in order.\n\nRequest 1 automatically saves the created ID into opportunityId for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "opportunityId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Create Opportunity - AI Vision",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Response contains created opportunity', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('id');",
              "});",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('opportunityId', String(json.data.id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deep Learning for Medical Imaging\",\n  \"description\": \"Develop CNN models to detect anomalies in X-ray and MRI scans.\",\n  \"researchArea\": \"Artificial Intelligence\",\n  \"facultyName\": \"Dr. Ayesha Khan\",\n  \"department\": \"Computer Science\",\n  \"requiredSkills\": \"Python, PyTorch, Machine Learning\",\n  \"availablePositions\": 2,\n  \"applicationDeadline\": \"2026-12-15\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["api", "opportunities"]
        }
      }
    },
    {
